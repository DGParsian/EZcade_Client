<Window x:Class="EZcade_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EZcade Client" Height="450" Width="800" Background="#f4f4f4"
                     
        Icon="/logo.ico"
        Closing="Window_Closing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label x:Name="ip_Lable" Content="IP Address" FontSize="16" FontWeight="Bold"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,10"/>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Margin="0,41,415,225" Grid.RowSpan="3" Width="150" >
            <CheckBox Content="Automation" Margin =" 0,41,0,10" Style="{StaticResource CustomCheckBox}"
                      Checked="Automation_CheckBox_Checked"
                      Unchecked="Automation_CheckBox_Unchecked" IsChecked="False" Height="26"/>
            <CheckBox Content="BarCode" Style="{StaticResource CustomCheckBox}"
                      Checked="DataMatrix_CheckBox_Checked"
                      Unchecked="DataMatrix_CheckBox_Unchecked" IsChecked="False" Height="24"/>
        </StackPanel>
        <Grid Margin="0,23,105,225" Grid.Row="2" HorizontalAlignment="Right" Width="355">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition/>
                <RowDefinition Height="24*"/>
            </Grid.RowDefinitions>
            <ComboBox x:Name="firstComboBox" Height="30"
                  ItemsSource="{Binding FirstOptions}"
                  Margin="115,14,115,0"
                  VerticalAlignment="Top" Grid.RowSpan="3" 
                  SelectionChanged="firstComboBox_SelectionChanged"/>

            <ComboBox x:Name="secondComboBox" Height="30"
                    ItemsSource="{Binding SecondOptions}"
                  Margin="115,21,115,0"
                  VerticalAlignment="Top" Grid.Row="2" />
        </Grid>
        <TextBox x:Name="serial_number_TextBox" Grid.Row="2"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Width="270" Height="50" Style="{StaticResource CustomTextBox}"
                 IsEnabled="False" TextAlignment="Center" Margin="0,163,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,238,0,35" Width="250">
            <Button x:Name="print_Buttun" Content="Print" Width="75" Height="40"
                    Click="print_Buttun_Click" Style="{StaticResource CustomButton}"/>
            <Button x:Name="Edit_Button" Content="Edit" Width="75" Height="40"
                    Click="Edit_Button_Click" Style="{StaticResource CustomButton}" Margin="10,0"/>
            <Button x:Name="Cancel_Button" Content="Cancel" Width="75" Height="40"
                    Click="Cancel_Button_Click" Style="{StaticResource CustomButton}" RenderTransformOrigin="0.875,0.497"/>
        </StackPanel>
    </Grid>
</Window>
