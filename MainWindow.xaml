<Window x:Class="EZcade_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EZcade_Client"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Closing="Window_Closing">
    <Grid>
        <Label x:Name="ip_Lable" Content="Label" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="serial_number_TextBox" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Width="193" IsEnabled="False" Height="61"/>
        <Button x:Name="print_Buttun" Content="Print" HorizontalAlignment="Right" Margin="0,253,286,0" VerticalAlignment="Top" Height="39" Width="61" Click="print_Buttun_Click"/>
        <Button x:Name="Edit_Button" Content="Edit" HorizontalAlignment="Center" Margin="0,252,0,0" VerticalAlignment="Top" Height="39" Width="61" Click="Edit_Button_Click"/>
        <Button x:Name="Cancel_Button" Content="Cancel" HorizontalAlignment="Left" Margin="286,252,0,0" VerticalAlignment="Top" Height="39" Width="61" Click="Cancel_Button_Click"/>

    </Grid>
</Window>
