
<Window x:Class="EZcade_Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="200" Width="300" WindowStartupLocation="CenterScreen">
    <Grid>
        <Label Content="Username:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,30,0,0"/>
        <TextBox x:Name="UsernameTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,30,0,0" Width="150"/>
        <Label Content="Password:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,70,0,0"/>
        <PasswordBox x:Name="PasswordBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,70,0,0" Width="150"/>
        <Button Content="Login" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Width="80" Click="LoginButton_Click"/>
    </Grid>
</Window>