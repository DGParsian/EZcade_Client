<Window x:Class="EZcade_Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EZcade_Client"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid>
        <Label Content="Login" HorizontalAlignment="Center" Margin="0,77,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="Username_Textbox" HorizontalAlignment="Left" Margin="400,128,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="username" HorizontalAlignment="Left" Margin="311,124,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="Password_Textbox" HorizontalAlignment="Left" Margin="400,175,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" />
        <Label Content="password" HorizontalAlignment="Left" Margin="311,171,0,0" VerticalAlignment="Top"/>
        <Button x:Name="login_Button" Content="Login" HorizontalAlignment="Center" Margin="0,263,0,0" VerticalAlignment="Top" Height="44" Width="92"/>

    </Grid>
</Window>
